# ============================================================================
# AI Red Team & Blue-Green Deployment Configuration (.env.example)
# Place your .env file right here in the project root:
#   /home/snorlax/Projects/agent_blue_green/.env
# ============================================================================

# --- 1. Blue-Green Security Gate Thresholds ---
MAX_ACCEPTABLE_RISK_PCT=20.0
ALLOW_ZERO_CRITICAL_ONLY=true
SANDBOX_TIMEOUT_SECONDS=5.0
MAX_ACCEPTABLE_LATENCY_MS=2000.0

# --- 2. GitHub Continuous Watcher (Leave GITHUB_TOKEN empty for public repos!) ---
GITHUB_TOKEN=
GIT_CLONE_TIMEOUT_SECONDS=60
DEFAULT_POLL_INTERVAL_SECONDS=30

# --- 3. OpenRouter LLM Integration (Recommended Unified AI Provider) ---
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- 4. Other Optional LLM / AI Provider Keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
